DATABASE_URL=mysql://USUARIO:SENHA@HOST:4000/BANCO
DATABASE_SSL=true
JWT_SECRET=                      # openssl rand -hex 32
DATA_ENCRYPTION_KEY=             # openssl rand -hex 32 (NÃO troque depois: dados cifrados deixam de abrir)
ADMIN_USERNAME=educalegaro       # aceita também digitar @educalegaro no app
ADMIN_PASSWORD=                  # a senha da gestão (sem aspas)
GOOGLE_WEB_CLIENT_ID=470980545863-kf726hfmdfk6mml19dnc91fdk6i3u06n.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=        # Google Cloud → Credenciais → cliente "Aplicativo da Web"
FIREBASE_SERVICE_ACCOUNT_JSON=   # JSON da conta de serviço do projeto do google-services.json (ou em base64)
EXPO_ACCESS_TOKEN=               # opcional (fallback Expo Push)
BREVO_API_KEY=                   # e-mails de confirmação
BREVO_SENDER_EMAIL=
ALLOWED_ORIGINS=

